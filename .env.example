# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public by design: the database's row-level security
# (supabase/schema.sql) is what keeps editing to admins.
# Leave them empty to run the site on the showcase cars, with the admin
# portal in browser-only preview mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
